config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Thistledown Academy: The Hollow Bell"
config/description="A gothic-mystery boarding-school game. Investigate the disappearances near Thistledown Academy's lake and uncover the Hollow Bell."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/managers/GameManager.cs"
DayNightManager="*res://scripts/managers/DayNightManager.cs"
SaveManager="*res://scripts/save/SaveManager.cs"
ClueDatabase="*res://scripts/clues/ClueDatabase.cs"
RelationshipManager="*res://scripts/relationships/RelationshipManager.cs"
DialogueManager="*res://scripts/dialogue/DialogueManager.cs"

[dotnet]

project/assembly_name="ThistledownHollowBell"

